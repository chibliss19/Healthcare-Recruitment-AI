@page "/forgot-password"
@using HealthcareRecruitment.Client.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Forgot password - Healthcare Vacancies in Northern Ireland</PageTitle>

<div class="d-flex align-center justify-center" style="min-height: 80vh;">
    <div style="width: 100%; max-width: 440px;">
        <div class="mb-6 text-center">
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0f172a; letter-spacing: -0.025em;" Class="mb-1">
                Forgot your password?
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #64748b;">
                Enter your email and we'll send you a code to reset it.
            </MudText>
        </div>

        <MudPaper Elevation="0" Class="pa-8 rounded-xl" Style="background: #ffffff; border: 1px solid #e2e8f0;">
            @if (_infoMessage is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4 rounded-lg">@_infoMessage</MudAlert>
            }

            <MudTextField T="string" @bind-Value="_email" Label="Email address" Variant="Variant.Outlined"
                          Class="mb-6" InputType="InputType.Email" Margin="Margin.Dense" Style="background-color: #f8fafc;" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="py-3 rounded-lg"
                       Disabled="@_submitting" OnClick="@SubmitAsync" Style="background-color: #2563eb; text-transform: none; font-weight: 600;">
                @(_submitting ? "Sending..." : "Send reset code")
            </MudButton>

            <MudText Typo="Typo.body2" Class="mt-6 text-center" Style="color: #64748b;">
                Already have a code? <MudLink Href="@($"reset-password?email={Uri.EscapeDataString(_email)}")" Style="font-weight: 600; color: #2563eb;">Reset password</MudLink>
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-2 text-center" Style="color: #64748b;">
                <MudLink Href="login" Style="font-weight: 600; color: #2563eb;">Back to log in</MudLink>
            </MudText>
        </MudPaper>
    </div>
</div>

@code {
    private string _email = "";
    private bool _submitting;
    private string? _infoMessage;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            return;
        }

        _submitting = true;
        try
        {
            _infoMessage = await Auth.ForgotPasswordAsync(_email);
            Nav.NavigateTo($"reset-password?email={Uri.EscapeDataString(_email)}");
        }
        finally
        {
            _submitting = false;
        }
    }
}
