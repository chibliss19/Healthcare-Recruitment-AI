@page "/verify-email"
@using HealthcareRecruitment.Client.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Verify your email - Healthcare Vacancies in Northern Ireland</PageTitle>

<div class="d-flex align-center justify-center" style="min-height: 80vh;">
    <div style="width: 100%; max-width: 440px;">
        <div class="mb-6 text-center">
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0f172a; letter-spacing: -0.025em;" Class="mb-1">
                Verify your email
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #64748b;">
                We sent a 6-digit code to @(_email ?? "your email"). Enter it below to finish creating your account.
            </MudText>
        </div>

        <MudPaper Elevation="0" Class="pa-8 rounded-xl" Style="background: #ffffff; border: 1px solid #e2e8f0;">
            @if (Auth.LastError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4 rounded-lg">@Auth.LastError</MudAlert>
            }
            @if (_infoMessage is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4 rounded-lg">@_infoMessage</MudAlert>
            }

            <MudTextField T="string" @bind-Value="_email" Label="Email address" Variant="Variant.Outlined"
                          Class="mb-4" InputType="InputType.Email" Margin="Margin.Dense" Style="background-color: #f8fafc;" />
            <MudTextField T="string" @bind-Value="_code" Label="6-digit code" Variant="Variant.Outlined"
                          Class="mb-6" Margin="Margin.Dense" MaxLength="6" Style="background-color: #f8fafc; letter-spacing: 4px;" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="py-3 rounded-lg mb-3"
                       Disabled="@_submitting" OnClick="@SubmitAsync" Style="background-color: #2563eb; text-transform: none; font-weight: 600;">
                @(_submitting ? "Verifying..." : "Verify")
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Class="rounded-lg"
                       Disabled="@_resending" OnClick="@ResendAsync" Style="text-transform: none; font-weight: 600;">
                @(_resending ? "Sending..." : "Resend code")
            </MudButton>

            <MudText Typo="Typo.body2" Class="mt-6 text-center" Style="color: #64748b;">
                Already verified? <MudLink Href="login" Style="font-weight: 600; color: #2563eb;">Log in</MudLink>
            </MudText>
        </MudPaper>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }

    private string? _email;
    private string _code = "";
    private bool _submitting;
    private bool _resending;
    private string? _infoMessage;

    protected override void OnInitialized()
    {
        _email = Email ?? Auth.UnverifiedEmail;
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            return;
        }

        _submitting = true;
        _infoMessage = null;
        try
        {
            if (await Auth.VerifyEmailAsync(_email, _code.Trim()))
            {
                Nav.NavigateTo("");
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ResendAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            return;
        }

        _resending = true;
        try
        {
            _infoMessage = await Auth.ResendVerificationAsync(_email);
        }
        finally
        {
            _resending = false;
        }
    }
}
