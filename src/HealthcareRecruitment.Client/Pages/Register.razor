@page "/register"
@using HealthcareRecruitment.Client.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Sign up - Healthcare Vacancies in Northern Ireland</PageTitle>

<div class="d-flex align-center justify-center" style="min-height: 80vh;">
    <div style="width: 100%; max-width: 440px;">
        <div class="mb-6 text-center">
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0f172a; letter-spacing: -0.025em;" Class="mb-1">
                Create an Account
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #64748b;">
                Needed to save jobs and submit applications. Browsing never requires an account.
            </MudText>
        </div>

        <MudPaper Elevation="0" Class="pa-8 rounded-xl" Style="background: #ffffff; border: 1px solid #e2e8f0;">
            @if (Auth.LastError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4 rounded-lg">@Auth.LastError</MudAlert>
            }

            <MudTextField T="string" @bind-Value="_fullName" Label="Full name" Variant="Variant.Outlined" Class="mb-4" Margin="Margin.Dense" Style="background-color: #f8fafc;" />
            <MudTextField T="string" @bind-Value="_email" Label="Email address" Variant="Variant.Outlined"
                          Class="mb-4" InputType="InputType.Email" Margin="Margin.Dense" Style="background-color: #f8fafc;" />
            <MudTextField T="string" @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                          Class="mb-6" InputType="InputType.Password" HelperText="At least 8 characters" Margin="Margin.Dense" Style="background-color: #f8fafc;" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="py-3 rounded-lg"
                       Disabled="@_submitting" OnClick="@SubmitAsync" Style="background-color: #2563eb; text-transform: none; font-weight: 600;">
                @(_submitting ? "Creating account..." : "Sign up")
            </MudButton>

            <MudText Typo="Typo.body2" Class="mt-6 text-center" Style="color: #64748b;">
                Already have an account? <MudLink Href="login" Style="font-weight: 600; color: #2563eb;">Log in</MudLink>
            </MudText>
        </MudPaper>
    </div>
</div>

@code {
    private string _fullName = "";
    private string _email = "";
    private string _password = "";
    private bool _submitting;

    private async Task SubmitAsync()
    {
        _submitting = true;
        try
        {
            if (await Auth.RegisterAsync(_email, _fullName, _password))
            {
                Nav.NavigateTo($"verify-email?email={Uri.EscapeDataString(_email)}");
            }
        }
        finally
        {
            _submitting = false;
        }
    }
}