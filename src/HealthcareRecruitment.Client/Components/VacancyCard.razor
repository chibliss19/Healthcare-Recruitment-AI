<MudCard Elevation="2" Class="d-flex flex-column" Style="height: 100%;">
    <MudCardContent Class="flex-grow-1">
        <div class="d-flex justify-space-between align-start">
            <MudText Typo="Typo.h6" Style="line-height: 1.3;">@Vacancy.Title</MudText>
            @if (ShowBookmark)
            {
                <MudIconButton Icon="@(IsBookmarked ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                               Color="@(IsBookmarked ? Color.Primary : Color.Default)"
                               Size="Size.Small"
                               OnClick="@(() => OnToggleBookmark.InvokeAsync(Vacancy))"
                               title="@(IsBookmarked ? "Remove bookmark" : "Bookmark this vacancy")" />
            }
        </div>
        <MudText Typo="Typo.subtitle2" Color="Color.Primary">@Vacancy.Employer</MudText>
        <div class="d-flex align-center gap-1 mt-1">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
            <MudText Typo="Typo.body2">@Vacancy.Location</MudText>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@SalaryText</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@Vacancy.Source</MudChip>
            @if (Vacancy.PostedDate is not null)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">Posted @Vacancy.PostedDate.Value.ToString("d MMM yyyy")</MudChip>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Vacancy.Description))
        {
            <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">@Truncate(Vacancy.Description, 180)</MudText>
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton Href="@($"apply/{Vacancy.Id}")" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Send">
            Apply
        </MudButton>
        @if (!string.IsNullOrWhiteSpace(Vacancy.Url))
        {
            <MudButton Href="@Vacancy.Url" Target="_blank" Rel="noopener"
                       EndIcon="@Icons.Material.Filled.OpenInNew" Color="Color.Default" Size="Size.Small">
                Original listing
            </MudButton>
        }
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired] public Vacancy Vacancy { get; set; } = default!;
    [Parameter] public bool ShowBookmark { get; set; }
    [Parameter] public bool IsBookmarked { get; set; }
    [Parameter] public EventCallback<Vacancy> OnToggleBookmark { get; set; }

    private string SalaryText => (Vacancy.SalaryMin, Vacancy.SalaryMax) switch
    {
        (null, null) => "Salary not stated",
        ({ } min, null) => $"From £{min:N0}",
        (null, { } max) => $"Up to £{max:N0}",
        ({ } min, { } max) when min == max => $"£{min:N0}",
        ({ } min, { } max) => $"£{min:N0} – £{max:N0}",
    };

    private static string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max].TrimEnd() + "…";
}
